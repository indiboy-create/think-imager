{
    "name": "youvision/think-imager",
    "description": "基于 Intervention Image 的 ThinkPHP 8 图片处理扩展",
    "keywords": [
        "thinkphp",
        "image",
        "imager",
        "intervention",
        "thumbnail",
        "watermark",
        "gd",
        "imagick"
    ],
    "homepage": "https://github.com/youvision/think-imager",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "intervention/image": "^4.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkImager\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkImager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkImager\\ImagerService"
            ],
            "config": {
                "imager": "config/imager.php"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}